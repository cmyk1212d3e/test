# Supabase Database Settings
# Use the PostgreSQL Session Pool connection string from Supabase Dashboard:
# Project Settings -> Database -> Connection string -> Session pooler
SUPABASE_DB_SESSION_POOL_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Optional server-side pool size for the Next.js API route.
SUPABASE_DB_POOL_MAX=5

# Supabase Session Pool connections normally require SSL. Set to false only for local Postgres.
SUPABASE_DB_SSL=true
